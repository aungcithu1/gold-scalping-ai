OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Research defaults
MAX_SPREAD=0.60
VOL_SPIKE_RATIO=1.80
RISK_PER_TRADE=0.0025
MAX_DAILY_LOSS=0.01
MAX_TRADES_PER_DAY=8

# FxPro MT5 bridge endpoint.
# Local Mac Streamlit + bridge:
MT5_BRIDGE_URL=http://127.0.0.1:8765

# Streamlit Cloud requires a publicly reachable HTTPS bridge URL instead of localhost.
